# ── Pareto-evals configuration ─────────────────────────────────────────────
# Copy this file to `.env` and fill in your credentials:  cp .env.example .env
# The runner reads it automatically. Nothing here is committed (.env is gitignored).

# ── Your Pareto API (the model under test) ──────────────────────────────────
# Any OpenAI-compatible chat-completions endpoint. The runner reads cost per
# request straight from the response (Pareto returns it), so no price needed.
PARETO_BASE_URL=https://your-pareto-endpoint/v1
PARETO_API_KEY=sk-...
PARETO_MODEL=pareto
PARETO_LABEL=Pareto
# Stream responses (MODEL_STREAM=true): needed for long high-effort generations that
# exceed a proxy's non-stream timeout — streaming has no wall cap (TTFB + per-chunk only).
MODEL_STREAM=false

# ── Comparison model (head-to-head, e.g. Claude Opus) ───────────────────────
# Also an OpenAI-compatible endpoint (Opus via an OpenAI-compatible gateway/proxy,
# OpenRouter, litellm, etc. — NOT Anthropic's native API). Leave BASE_URL blank
# (or pass --models pareto) to skip the comparison and run Pareto only.
COMPARISON_BASE_URL=https://your-openai-compatible-gateway/v1
COMPARISON_API_KEY=sk-...
COMPARISON_MODEL=anthropic/claude-opus-4.8
COMPARISON_LABEL=Opus-4.8
# If the comparison endpoint does NOT return cost in its responses, set per-1M-token
# prices and the runner will compute $/task from token usage. (Opus 4.8 list price
# shown; edit for your model. Omit if the endpoint returns cost inline.)
COMPARISON_INPUT_PRICE_PER_MTOK=5
COMPARISON_OUTPUT_PRICE_PER_MTOK=25

# Per-1M-token prices for the Pareto model. Not needed for the API benchmarks (cost
# comes from the response), but REQUIRED for the agentic `swe_rebench` benchmark: the
# agentic harness can't propagate inline cost, so its $/task is computed from token
# usage × these prices.
# PARETO_INPUT_PRICE_PER_MTOK=...
# PARETO_OUTPUT_PRICE_PER_MTOK=...

# ── Agentic benchmark: swe_rebench (opt-in) ─────────────────────────────────
# Only needed if you run `--benchmarks swe_rebench`. Requires Docker + mini-swe-agent
# + the SWE-rebench fork of `swebench` (see scripts/bootstrap-swe.sh and the README).
# SWE_MINI_BIN=/path/to/mini-swe-agent/venv/bin/mini-extra   # mini-swe-agent entrypoint
# SWE_GRADER_PYTHON=/path/to/swe-rebench-fork/venv/bin/python # python with the SWE-rebench fork installed
# SWE_DATASET=nebius/SWE-rebench-leaderboard   # default (contamination-clean monthly splits)
# SWE_SPLIT=2026_03                            # default split (post-cutoff, clean)
# SWE_FILTER_IDS=inst1,inst2                   # optional: run exactly these instance ids

# ── Judge (for free-form graders: HLE) ──────────────────────────────────────
# HLE answers are free-form and require an INDEPENDENT LLM judge (must not be the
# model under test). Configure any OpenAI-compatible endpoint. If unset, HLE falls
# back to a containment match (fine for smoke tests, NOT publication-grade).
JUDGE_BASE_URL=https://your-openai-compatible-gateway/v1
JUDGE_API_KEY=sk-...
JUDGE_MODEL=openai/gpt-5.5
JUDGE_TIMEOUT=90
