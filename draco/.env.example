# DRACO benchmark — point it at any OpenAI-compatible endpoint.
# Copy to .env and fill in.

# Your model's endpoint (OpenAI-compatible /v1/chat/completions lives under this base).
GATEWAY_BASE_URL=https://your-endpoint.example.com
# Bearer API key for that endpoint.
GATEWAY_API_KEY=

# The model to evaluate (as your endpoint names it).
BENCH_MODEL=your-model

# LLM judge that grades DRACO rubrics (any OpenAI-compatible model id your endpoint serves).
JUDGE_MODEL=google-ai-studio/gemini-3-pro
# Optional: separate key for the judge (defaults to GATEWAY_API_KEY).
# JUDGE_CONNECTION_TOKEN=

# Optional knobs.
# BENCH_CONCURRENCY=3
